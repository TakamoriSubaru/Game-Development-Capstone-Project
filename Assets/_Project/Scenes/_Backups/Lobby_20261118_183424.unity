  m_Script: {fileID: 11500000, guid: 7e0f1e54576170dfe9ff54672f7070d0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CharacterTalker
  rig: {fileID: 1237969559}
  ui: {fileID: 708343380}
  model: {fileID: 1372844257}
  mouth: {fileID: 1486697604}
  animator: {fileID: 0}
  speakerName: Polites
  idleSeconds: 6
  lines:
  - A quiet day by the fire. I could get used to this.
  - Pick a direction. The window, the map, or the door.
  - Ithaca is still far. But every journey starts at a table like this one.
  - The crew is restless. Shall we look at the charts?
