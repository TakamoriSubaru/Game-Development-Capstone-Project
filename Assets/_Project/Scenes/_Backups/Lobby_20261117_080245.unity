  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PropHotspot
  label: Sleeping Dog
  speaker: Polites
  lines:
  - He has slept since the day we docked. Lucky dog.
  - Best not to wake him. He snores like a storm.
  - His paws twitch. Chasing gulls, I would say.
  idleSeconds: 4
  sfx: {fileID: 0}
  sfxVolume: 0.8
  showMarker: 0
