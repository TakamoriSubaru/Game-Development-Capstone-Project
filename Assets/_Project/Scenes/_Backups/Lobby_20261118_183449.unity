  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PropHotspot
  label: Fireplace
  speaker: Polites
  lines:
  - The embers glow. I could sit here until morning.
  - Keep the fire fed and the crew keeps its spirits.
  - A hearth like this makes Ithaca feel a little closer.
  idleSeconds: 4
  sfx: {fileID: 0}
