+            var rt = UIFactory.NewRect(box, name);
+            UIFactory.Stretch(rt, 0f, 0f, 1f, 1f);
+            var fit = rt.gameObject.AddComponent<AspectRatioFitter>();
+            fit.aspectMode = AspectRatioFitter.AspectMode.FitInParent;
+            fit.aspectRatio = aspect;
+            return rt;
